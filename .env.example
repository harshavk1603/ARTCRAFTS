# ARTCRAFTS Environment Configuration
# Copy to .env and fill in your values. Do not commit .env.

NODE_ENV=development
API_PORT=3001
PORT=3001

# Frontend URL (set to your Vercel URL in production for CORS)
FRONTEND_URL=http://localhost:5173

# Database path (absolute path on Render with persistent disk)
DB_PATH=./data/artcrafts.sqlite

# Session Secret (generate a strong random value for production)
SESSION_SECRET=change-me-to-a-random-64-char-string

# Admin Bootstrap Credentials (REQUIRED in production)
ADMIN_EMAIL=admin@artcrafts.com
ADMIN_NAME=ARTCRAFTS Administrator
ADMIN_PASSWORD=ArtCraftsAdmin@2026!

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=artcrafts-media

# PostgreSQL Connections (optional, for future migration)
DATABASE_URL=
DIRECT_URL=

# Email Notifications via Resend
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=orders@artcrafts.com
