# ARTCRAFTS Environment Configuration
# Copy to .env and fill in your values. Never commit .env.

# ── Backend (Render / local API) ─────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated allowed browser origins, without trailing slashes.
# Production: https://artcrafts.vercel.app,https://artcrafts-git-main-you.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional public URL for local-disk uploads when Supabase Storage is not used.
# Render sets RENDER_EXTERNAL_URL automatically, so this is usually unnecessary.
API_PUBLIC_URL=

# Set to 1 only when this server also serves dist/ (single-service/local use).
SERVE_FRONTEND=

# Supabase Postgres. Copy the complete Session pooler URI from Supabase > Connect.
# Use it for DATABASE_URL on Render. DIRECT_URL is optional locally.
DATABASE_URL=
DIRECT_URL=
PG_POOL_MAX=5

# Admin Bootstrap Credentials (REQUIRED in production; password >= 10 chars)
ADMIN_EMAIL=admin@artcrafts.com
ADMIN_NAME=ARTCRAFTS Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-10-characters

# Razorpay (optional; checkout falls back to Cash on Delivery when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase Storage. Use the service-role key (or a secret key). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=artcrafts-media

# Email notifications via Resend (optional)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=orders@artcrafts.com

# ── Frontend (Vercel / local Vite) ───────────────────────────────────────
# Leave empty locally so Vite proxies /api and /uploads to port 3001.
# In Vercel set this to the Render URL, e.g. https://artcrafts-api.onrender.com
VITE_API_URL=
